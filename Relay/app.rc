// Relay EXE 资源文件: 内嵌程序图标
#include <winres.h>
1 ICON "..\\..\\assets\\app_icon_relay.ico"
1 VERSIONINFO
FILEVERSION     0,0,3,0
PRODUCTVERSION  0,0,3,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FileTransfer"
            VALUE "FileDescription",  "FileTransfer Relay Server"
            VALUE "FileVersion",      "0.0.3.0"
            VALUE "InternalName",     "FileTransferRelay"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "FileTransferRelay.exe"
            VALUE "ProductName",      "FileTransfer Relay Server"
            VALUE "ProductVersion",   "0.0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
