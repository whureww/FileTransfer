// Client EXE 资源文件: 内嵌程序图标
// MSVC rc.exe 编译: IDI_APPLICATION (1) 是默认图标资源 ID
#include <winres.h>
1 ICON "..\\..\\assets\\app_icon.ico"
1 VERSIONINFO
FILEVERSION     0,0,8,0
PRODUCTVERSION  0,0,8,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FileTransfer"
            VALUE "FileDescription",  "FileTransfer Client - File transfer via LAN / room code"
            VALUE "FileVersion",      "0.0.8.0"
            VALUE "InternalName",     "FileTransfer"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "FileTransfer.exe"
            VALUE "ProductName",      "FileTransfer Client"
            VALUE "ProductVersion",   "0.0.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
